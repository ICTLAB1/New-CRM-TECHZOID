# Copy to .env and fill in from Supabase Dashboard -> Project Settings -> API.
# The anon key is safe to ship in the built app: it has no power on its own,
# access is controlled entirely by the Row Level Security policies in supabase/.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
